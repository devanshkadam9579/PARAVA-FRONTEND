rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role in ['admin', 'master_admin'] ||
        (request.auth.token.email != null && request.auth.token.email.lower() in [
          'devanshkadam2@gmail.com',
          'devenshkadam2@gmail.com',
          'devansh@parva.com',
          'admin@myparva.com',
          'rohan@myparva.com',
          'devanshkadam9579@gmail.com',
          'admin@parva.com'
        ]) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'master_admin'])
      );
    }

    // 1. Users: Users can read and update their own profile fields. Privilege escalation (role/admin flags) is blocked.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (!request.resource.data.keys().hasAny(['role', 'isAdmin', 'isMasterAdmin']) || request.resource.data.role == 'customer') || isAdmin();
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'isMasterAdmin', 'emailVerified'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Vendors: Public catalog read; updates restricted to verified vendor owner. Status/verification changes require Admin.
    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if (isAuthenticated() && (request.auth.uid == vendorId || request.resource.data.ownerUid == request.auth.uid) && !request.resource.data.keys().hasAny(['verified', 'featured', 'status', 'commissionPercentage'])) || isAdmin();
      allow update: if (isAuthenticated() && (request.auth.uid == vendorId || resource.data.ownerUid == request.auth.uid || resource.data.userId == request.auth.uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'featured', 'status', 'commissionPercentage'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // 3. Bookings: Customer can read/update own bookings; Vendor can read/update assigned bookings; Admin manages all.
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.customerUid == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        resource.data.vendor.id == request.auth.uid ||
        resource.data.vendorOwnerUid == request.auth.uid
      ));
      allow create: if isAdmin() || (isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.customerUid == request.auth.uid
      ));
      allow update: if isAdmin() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.customerUid == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        resource.data.vendor.id == request.auth.uid ||
        resource.data.vendorOwnerUid == request.auth.uid
      ));
      allow delete: if isAdmin();
    }

    // 4. Chats: Authenticated participants only (Customer, Vendor, or Admin)
    match /chats/{chatId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.customerUid == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        resource.data.vendor.id == request.auth.uid ||
        resource.data.vendorOwnerUid == request.auth.uid
      ));
      allow create: if isAdmin() || (isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.customerUid == request.auth.uid ||
        request.resource.data.vendorId == request.auth.uid ||
        request.resource.data.vendorOwnerUid == request.auth.uid
      ));
      allow update, delete: if isAdmin();
    }

    // 5. Notifications: Strictly scoped to recipient. Admin notifications readable only by verified admins.
    match /notifications/{notificationId} {
      allow read: if (isAuthenticated() && (
        resource.data.recipientUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.token.vendorId
      )) || (isAdmin() && (resource.data.recipientUid == 'admin' || true));
      allow create: if isAdmin() || isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.recipientUid == request.auth.uid);
    }

    // 6. Broadcast Notifications: Public read for announcements, admin only write
    match /broadcast_notifications/{broadcastId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Public Marketplace Catalogs (Categories, Promos, Cities, Coupons, Settings)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promos/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Reviews: Public read, authenticated user write own review
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // 9. Transactions: Read only by transaction owner or admin; write only by admin/backend
    match /transactions/{txId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.customerUid == request.auth.uid
      ));
      allow write: if isAdmin();
    }

    // 10. Leads: Admin or assigned vendor
    match /leads/{leadId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.vendorId == request.auth.uid ||
        resource.data.vendorOwnerUid == request.auth.uid
      ));
      allow write: if isAdmin();
    }

    // 11. Connections: Customer access only
    match /connections/{connectionId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
    }

    // 12. Admins collection: Strict admin only
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // 13. Secure Default Deny Fallback: Replaces insecure wildcard match
    match /{document=**} {
      allow read, write: if false;
    }
  }
}